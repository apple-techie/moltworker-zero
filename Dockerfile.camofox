FROM node:18-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    python3 \
    pip \
  && pip install --break-system-packages yt-dlp \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone and install camofox-browser
# postinstall runs `npx camoufox-js fetch` which downloads the Camoufox binary (~300MB)
RUN git clone --depth=1 https://github.com/jo-inc/camofox-browser.git . \
  && npm install \
  && rm -rf .git

ENV MAX_SESSIONS=5
ENV MAX_OLD_SPACE_SIZE=128

EXPOSE 9377

CMD ["npm", "start"]
